@page "/inscricao"
@rendermode InteractiveServer
@using SistemaInscricaoCursosBlazor.Components.Models

<PageTitle>Inscrição em Cursos</PageTitle>

<h3>Formulário de Inscrição em Cursos</h3>

@if (sucesso)
{
    <div class="alert alert-success" role="alert">
        <strong>Inscrição realizada com sucesso!</strong> Os dados de <strong>@modelo.Nome</strong> foram registados.
    </div>
}

<EditForm Model="modelo" FormName="InscricaoForm" OnValidSubmit="ProcessarInscricao" style="max-width: 500px;">
    <DataAnnotationsValidator />
    <ValidationSummary class="text-danger" />

    <div class="mb-3">
        <label class="form-label">Nome Completo:</label>
        <InputText class="form-control" @bind-Value="modelo.Nome" placeholder="Digite o seu nome" />
        <ValidationMessage For="@(() => modelo.Nome)" class="text-danger" />
    </div>

    <div class="mb-3">
        <label class="form-label">E-mail:</label>
        <InputText class="form-control" @bind-Value="modelo.Email" placeholder="exemplo@email.com" />
        <ValidationMessage For="@(() => modelo.Email)" class="text-danger" />
    </div>

    <div class="mb-3">
        <label class="form-label">Idade:</label>
        <InputNumber class="form-control" @bind-Value="modelo.Idade" />
        <ValidationMessage For="@(() => modelo.Idade)" class="text-danger" />
    </div>

    <div class="mb-3">
        <label class="form-label">Curso Desejado:</label>
        <InputSelect class="form-select" @bind-Value="modelo.CursoId">
            <option value="">-- Selecione um curso --</option>
            <option value="eng-software">Engenharia de Software</option>
            <option value="dev-web-blazor">Desenvolvimento Web com .NET e Blazor</option>
            <option value="mobile-games">Desenvolvimento Mobile e Jogos</option>
        </InputSelect>
        <ValidationMessage For="@(() => modelo.CursoId)" class="text-danger" />
    </div>

    <button type="submit" class="btn btn-primary" disabled="@enviando">
        @(enviando ? "Processando..." : "Confirmar Inscrição")
    </button>
</EditForm>

@code {
    [SupplyParameterFromForm]
    public InscricaoModel modelo { get; set; } = new();

    private bool enviando = false;
    private bool sucesso = false;

    private async Task ProcessarInscricao()
    {
        enviando = true;
        sucesso = false;

        // Simula uma requisição assíncrona de 2 segundos
        await Task.Delay(2000);

        enviando = false;
        sucesso = true;
    }
}